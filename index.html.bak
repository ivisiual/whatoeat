<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="description" content="饭饭搭子 — 替选择困难的你，认真想好今天三顿饭" />
  <meta name="theme-color" content="#FF6B57" />
  <title>饭饭搭子 · 今天吃什么</title>
  <style>
    /* =========================================================
       饭饭搭子 · styles
       分区：变量 / 重置 / 布局 / 筛选 / 卡片 / 抽屉 / 动画
       ========================================================= */
    :root {
      --cream: #FFF8EE;
      --cream-deep: #F5EBD9;
      --tomato: #FF6B57;
      --tomato-deep: #E85540;
      --yolk: #FFC857;
      --yolk-soft: #FFE4A3;
      --avocado: #87B974;
      --avocado-deep: #6FA05C;
      --caramel: #6E4B3A;
      --caramel-soft: #A67C68;
      --ink: #3D2B22;
      --ink-soft: #6B5348;
      --line: rgba(110, 75, 58, 0.14);
      --shadow: 0 10px 28px rgba(110, 75, 58, 0.12);
      --shadow-soft: 0 4px 14px rgba(110, 75, 58, 0.08);
      --radius-lg: 24px;
      --radius-md: 16px;
      --radius-sm: 12px;
      --radius-pill: 999px;
      --font: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei",
              "Noto Sans SC", "Segoe UI", system-ui, -apple-system, sans-serif;
      --space-page: clamp(12px, 3vw, 32px);
      --panel-padding: clamp(14px, 2vw, 24px);
      --title-size: clamp(1.25rem, 2.5vw, 2rem);
      --card-gap: clamp(12px, 2vw, 20px);
      --safe-b: env(safe-area-inset-bottom, 0px);
      --transition: 0.22s cubic-bezier(0.34, 1.2, 0.64, 1);
      --breakfast: #FFC857;
      --lunch: #FF6B57;
      --dinner: #87B974;
      --touch: 44px;
      --sticky-h: 0px;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
    body {
      margin: 0; min-width: 320px; font-family: var(--font);
      color: var(--ink); background: var(--cream); line-height: 1.55;
    }
    button, input { font: inherit; color: inherit; }
    a { color: var(--tomato-deep); }
    :focus-visible { outline: 3px solid var(--yolk); outline-offset: 2px; }
    .sr-only {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
    }
    [hidden] { display: none !important; }

    .bg-deco { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
    .blob { position: absolute; border-radius: 50%; opacity: 0.5; }
    .blob-a {
      width: 220px; height: 220px; top: -60px; right: -40px;
      background: radial-gradient(circle at 30% 30%, var(--yolk-soft), transparent 70%);
    }
    .blob-b {
      width: 280px; height: 280px; bottom: 8%; left: -100px;
      background: radial-gradient(circle at 60% 40%, rgba(135,185,116,0.35), transparent 70%);
    }
    .blob-c {
      width: 150px; height: 150px; top: 40%; right: 5%;
      background: radial-gradient(circle at 40% 40%, rgba(255,107,87,0.16), transparent 70%);
    }

    .page {
      position: relative; z-index: 1;
      width: min(calc(100% - 2 * var(--space-page)), 1280px);
      margin-inline: auto;
      padding: clamp(12px, 2vw, 20px) 0 calc(1.5rem + var(--safe-b) + var(--sticky-h));
    }

    .site-header {
      display: flex; flex-wrap: wrap; align-items: center;
      justify-content: space-between; gap: 0.6rem 1rem;
      margin-bottom: clamp(0.75rem, 2vw, 1.2rem);
      min-width: 0;
    }
    .brand { display: flex; align-items: center; gap: 0.65rem; min-width: 0; flex: 1 1 auto; }
    .brand-mark {
      width: clamp(42px, 8vw, 52px); height: clamp(42px, 8vw, 52px); border-radius: 16px;
      background: linear-gradient(145deg, var(--tomato), #FF8F7A);
      box-shadow: var(--shadow-soft);
      display: grid; place-items: center; font-size: clamp(1.3rem, 3vw, 1.6rem);
      transform: rotate(-6deg);
      border: 2px solid rgba(255,255,255,0.5);
      flex-shrink: 0;
    }
    .brand-text { min-width: 0; }
    .brand-text h1 { margin: 0; font-size: var(--title-size); color: var(--caramel); line-height: 1.2; }
    .brand-text p { margin: 0.15rem 0 0; font-size: clamp(0.75rem, 1.6vw, 0.85rem); color: var(--ink-soft); }
    .header-right { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; min-width: 0; }
    .header-meta {
      text-align: right; background: rgba(255,255,255,0.7);
      border: 1.5px solid var(--line); border-radius: var(--radius-md);
      padding: 0.4rem 0.7rem; box-shadow: var(--shadow-soft); min-width: 0; max-width: 100%;
    }
    .header-meta .date { font-size: 0.86rem; font-weight: 600; color: var(--caramel); white-space: nowrap; }
    .header-meta .greet { margin-top: 0.1rem; font-size: 0.76rem; color: var(--ink-soft); max-width: 14rem; }
    .btn-icon {
      width: var(--touch); height: var(--touch); min-height: var(--touch);
      border-radius: 14px; padding: 0; display: inline-grid; place-items: center;
      font-size: 1.15rem; flex-shrink: 0;
    }

    .layout {
      display: flex; flex-direction: column;
      gap: clamp(14px, 2vw, 22px); min-width: 0;
    }

    .panel {
      background: rgba(255,255,255,0.82);
      border: 1.5px solid var(--line);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow);
      padding: var(--panel-padding);
      position: relative;
      min-width: 0; max-width: 100%;
    }
    .panel-title {
      margin: 0 0 0.75rem; font-size: 0.95rem; color: var(--caramel);
      display: flex; align-items: center; gap: 0.4rem;
    }
    .panel-title .dot {
      width: 8px; height: 8px; border-radius: 50%; background: var(--tomato);
      box-shadow: 0 0 0 3px rgba(255,107,87,0.2);
    }

    .filter-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px 18px;
      min-width: 0;
    }
    .filter-block { margin: 0; min-width: 0; max-width: 100%; }
    .filter-block--span2 { grid-column: span 2; min-width: 0; }
    .filter-block--span4 { grid-column: 1 / -1; min-width: 0; }
    .filter-label {
      display: block; font-size: 0.76rem; font-weight: 700;
      color: var(--caramel-soft); margin-bottom: 0.4rem; letter-spacing: 0.02em;
    }
    .chip-row { display: flex; flex-wrap: wrap; gap: 0.4rem; min-width: 0; max-width: 100%; }
    .chip {
      appearance: none; border: 1.5px solid var(--line); background: #fff;
      border-radius: var(--radius-pill); padding: 0.45rem 0.75rem;
      min-height: var(--touch); min-width: 0; max-width: 100%;
      font-size: 0.8rem; cursor: pointer; color: var(--ink-soft);
      white-space: nowrap;
      transition: transform var(--transition), background var(--transition),
                  border-color var(--transition), color var(--transition), box-shadow var(--transition);
    }
    .chip:hover { border-color: var(--caramel-soft); color: var(--caramel); transform: translateY(-1px); }
    .chip:active { transform: translateY(1px) scale(0.97); }
    .chip[aria-checked="true"], .chip[aria-pressed="true"] {
      background: var(--yolk); border-color: #E8B040; color: var(--caramel);
      font-weight: 700; box-shadow: 0 2px 0 #E0A830;
    }
    .chip.tag-chip[aria-pressed="true"] {
      background: #FDECEA; border-color: var(--tomato); color: var(--tomato-deep); box-shadow: none;
    }

    .cond-block {
      background: var(--cream); border: 1.5px dashed var(--line);
      border-radius: var(--radius-md); padding: 0.65rem 0.7rem; margin-bottom: 0.75rem;
    }
    .cond-block .filter-label { color: var(--caramel); }

    details.advanced {
      border: 1.5px solid var(--line); border-radius: var(--radius-md);
      background: #fff; margin-bottom: 0.85rem; overflow: hidden;
    }
    details.advanced > summary {
      cursor: pointer; list-style: none; padding: 0.65rem 0.8rem;
      font-size: 0.82rem; font-weight: 700; color: var(--caramel);
      display: flex; align-items: center; justify-content: space-between;
    }
    details.advanced > summary::-webkit-details-marker { display: none; }
    details.advanced > summary::after { content: "▾"; color: var(--caramel-soft); transition: transform 0.2s; }
    details.advanced[open] > summary::after { transform: rotate(180deg); }
    details.advanced .adv-body { padding: 0 0.75rem 0.75rem; }

    .filter-actions {
      display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
      gap: 0.75rem 1rem; margin-top: 1rem; min-width: 0;
    }
    .filter-actions .hint { margin: 0; flex: 1 1 12rem; min-width: 0; font-size: 0.78rem; color: var(--ink-soft); }
    .filter-actions .btn-primary { width: auto; min-width: min(280px, 100%); flex: 0 1 280px; }
    .filter-summary {
      display: none; align-items: center; justify-content: space-between; gap: 0.75rem; min-width: 0;
    }
    .filter-summary-text {
      font-size: 0.88rem; color: var(--caramel); font-weight: 600; min-width: 0; flex: 1;
      overflow-wrap: anywhere;
    }
    .panel-controls.is-collapsed .filter-full { display: none; }
    .panel-controls.is-collapsed .filter-summary { display: flex; }
    .panel-controls.is-collapsed .filter-actions { display: none; }
    .soften-banner {
      background: linear-gradient(135deg, #FFF6E8, #F3F9EE);
      border: 1.5px solid rgba(135,185,116,0.4);
      border-radius: var(--radius-md); padding: 0.65rem 0.85rem;
      font-size: 0.82rem; color: var(--ink-soft); margin-bottom: 0.85rem; min-width: 0;
    }
    .soften-banner strong { color: var(--avocado-deep); }
    .sticky-cta {
      display: none; position: sticky; bottom: calc(12px + var(--safe-b));
      z-index: 30; margin-top: 0.5rem;
    }
    .sticky-cta .btn-primary {
      width: 100%;
      box-shadow: 0 5px 0 var(--tomato-deep), 0 12px 28px rgba(255,107,87,0.35);
    }

    .btn {
      appearance: none; border: none; cursor: pointer;
      border-radius: var(--radius-pill); padding: 0.65rem 1.05rem;
      min-height: var(--touch);
      font-weight: 700; display: inline-flex; align-items: center; justify-content: center;
      gap: 0.35rem; text-decoration: none; line-height: 1.2; max-width: 100%;
      transition: transform var(--transition), box-shadow var(--transition), background var(--transition), opacity var(--transition);
    }
    .btn:hover { transform: translateY(-2px); }
    .btn:active { transform: translateY(3px) scale(0.98); box-shadow: none !important; }
    .btn:disabled { opacity: 0.55; cursor: not-allowed; transform: none !important; }
    .btn-primary {
      width: 100%; background: linear-gradient(180deg, #FF7A68, var(--tomato));
      color: #fff; font-size: 0.96rem; padding: 0.85rem 1rem;
      box-shadow: 0 5px 0 var(--tomato-deep), 0 10px 20px rgba(255,107,87,0.28);
    }
    .btn-primary:hover { box-shadow: 0 7px 0 var(--tomato-deep), 0 12px 22px rgba(255,107,87,0.32); }
    .btn-primary:active { box-shadow: 0 2px 0 var(--tomato-deep) !important; transform: translateY(4px) scale(0.99); }
    .btn-secondary {
      background: #fff; color: var(--caramel); border: 1.5px solid var(--line);
      box-shadow: 0 3px 0 rgba(110,75,58,0.12); font-size: 0.82rem; font-weight: 600;
    }
    .btn-secondary:hover { border-color: var(--caramel-soft); box-shadow: 0 4px 0 rgba(110,75,58,0.14); }
    .btn-secondary:active { box-shadow: 0 1px 0 rgba(110,75,58,0.12) !important; }
    .btn-ghost {
      background: transparent; color: var(--ink-soft); border: 1.5px dashed var(--line);
      font-size: 0.8rem; font-weight: 600;
    }
    .btn-ghost:hover { background: rgba(255,255,255,0.7); border-style: solid; color: var(--caramel); }
    .btn-sm { padding: 0.45rem 0.7rem; font-size: 0.8rem; border-radius: var(--radius-sm); min-height: var(--touch); }
    .btn-link {
      background: var(--cream-deep); color: var(--caramel); border: 1.5px solid var(--line);
      box-shadow: none; font-size: 0.76rem; font-weight: 600;
    }
    .btn-link:hover { background: var(--yolk-soft); border-color: #E8B040; }
    .btn-eaten {
      background: linear-gradient(180deg, #9BCB84, var(--avocado));
      color: #fff; border: none;
      box-shadow: 0 3px 0 var(--avocado-deep);
      font-size: 0.82rem; font-weight: 700;
    }
    .btn-eaten:hover { box-shadow: 0 4px 0 var(--avocado-deep); }
    .btn-eaten:active { box-shadow: 0 1px 0 var(--avocado-deep) !important; }
    .btn-danger {
      background: #fff; color: var(--tomato-deep); border: 1.5px solid rgba(255,107,87,0.4);
      font-size: 0.78rem; font-weight: 600;
    }

    .hint { margin: 0.65rem 0 0; font-size: 0.74rem; color: var(--ink-soft); line-height: 1.45; }
    .side-tools { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.75rem; }

    .results-head {
      display: flex; flex-wrap: wrap; align-items: flex-start;
      justify-content: space-between; gap: 0.5rem; margin-bottom: 0.85rem;
    }
    .results-head h2 { margin: 0; font-size: 1.05rem; color: var(--caramel); }
    .results-sub { margin: 0.15rem 0 0; font-size: 0.8rem; color: var(--ink-soft); }

    .meal-list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--card-gap);
      min-width: 0;
    }
    .meal-card {
      background: #fff; border: 1.5px solid var(--line);
      border-radius: var(--radius-lg); padding: clamp(0.75rem, 1.5vw, 0.95rem);
      box-shadow: var(--shadow-soft); position: relative; overflow: hidden;
      min-width: 0; max-width: 100%;
      opacity: 0; transform: translateY(14px) scale(0.98);
      display: flex; flex-direction: column;
    }
    .meal-card.is-shown {
      opacity: 1; transform: none;
      transition: opacity 0.4s ease, transform 0.45s cubic-bezier(0.34, 1.2, 0.64, 1);
    }
    .meal-card::after {
      content: ""; position: absolute; top: 0; left: 0; right: 0; height: 5px;
    }
    .meal-card[data-meal="breakfast"]::after { background: linear-gradient(90deg, #FFD56A, var(--breakfast)); }
    .meal-card[data-meal="lunch"]::after { background: linear-gradient(90deg, #FF8F7A, var(--lunch)); }
    .meal-card[data-meal="dinner"]::after { background: linear-gradient(90deg, #A8D08E, var(--dinner)); }
    .meal-card[data-meal="breakfast"] { background: linear-gradient(180deg, #FFFCF3 0%, #fff 40%); }
    .meal-card[data-meal="lunch"] { background: linear-gradient(180deg, #FFF7F5 0%, #fff 40%); }
    .meal-card[data-meal="dinner"] { background: linear-gradient(180deg, #F7FBF4 0%, #fff 40%); }
    .meal-card.is-placeholder {
      opacity: 1; transform: none; min-height: 120px;
      display: flex; flex-direction: row; align-items: center; gap: 0.85rem;
      border-style: dashed;
    }
    .meal-card.is-placeholder .ph-emoji {
      width: 56px; height: 56px; border-radius: 18px; display: grid; place-items: center;
      font-size: 1.6rem; background: var(--cream); border: 1.5px solid var(--line); flex-shrink: 0;
    }
    .meal-card.is-placeholder .ph-text strong { display: block; color: var(--caramel); font-size: 0.95rem; }
    .meal-card.is-placeholder .ph-text span { font-size: 0.8rem; color: var(--ink-soft); }
    .meal-card.is-swapping { animation: cardSwap 0.4s ease; }

    .buddy {
      display: flex; align-items: center; gap: 0.75rem;
      margin: 0.2rem 0 0.9rem; padding: 0.75rem 0.85rem;
      background: linear-gradient(135deg, #FFF4E8, #F0F8EA);
      border: 1.5px solid var(--line); border-radius: var(--radius-md);
    }
    .buddy-face {
      width: 56px; height: 56px; border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #fff, var(--yolk-soft));
      border: 2px solid rgba(255,200,87,0.6);
      display: grid; place-items: center; font-size: 1.7rem; flex-shrink: 0;
      box-shadow: var(--shadow-soft);
    }
    .buddy-text { font-size: 0.84rem; color: var(--ink-soft); }
    .buddy-text strong { color: var(--caramel); }

    .meal-top { display: flex; gap: 0.8rem; align-items: flex-start; }
    .food-visual {
      flex: 0 0 auto; width: 62px; height: 62px; border-radius: 20px;
      background: var(--cream); border: 1.5px solid var(--line);
      display: grid; place-items: center; font-size: 1.9rem; position: relative; overflow: hidden;
    }
    .food-visual .plate {
      position: absolute; inset: 10px; border-radius: 50%;
      border: 2px solid rgba(110,75,58,0.08);
      background: radial-gradient(circle at 35% 30%, #fff, var(--cream-deep));
    }
    .food-visual .emoji { position: relative; z-index: 1; }
    .meal-info { flex: 1; min-width: 0; }
    .meal-badge {
      display: inline-flex; align-items: center; gap: 0.25rem;
      font-size: 0.7rem; font-weight: 700; color: var(--caramel-soft);
      background: rgba(255,255,255,0.8); border-radius: var(--radius-pill);
      padding: 0.12rem 0.5rem; border: 1px solid var(--line); margin-bottom: 0.28rem;
    }
    .channel-pill {
      display: inline-block; margin-left: 0.25rem; font-size: 0.68rem;
      padding: 0.08rem 0.4rem; border-radius: var(--radius-pill);
      background: var(--cream-deep); color: var(--caramel); font-weight: 600;
    }
    .meal-name { margin: 0; font-size: 1.1rem; color: var(--ink); line-height: 1.3; word-break: break-word; }
    .meal-reason { margin: 0.3rem 0 0; font-size: 0.82rem; color: var(--ink-soft); }

    .meta-grid {
      display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.38rem; margin: 0.8rem 0 0.65rem;
    }
    @media (min-width: 520px) {
      .meta-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    .meta-item {
      background: rgba(255,248,238,0.85); border-radius: var(--radius-sm);
      padding: 0.38rem 0.48rem; border: 1px solid var(--line); min-width: 0;
    }
    .meta-item .k { display: block; font-size: 0.66rem; color: var(--caramel-soft); }
    .meta-item .v {
      display: block; font-size: 0.8rem; font-weight: 600; color: var(--caramel);
      margin-top: 0.05rem; word-break: break-word;
    }
    .tip-box {
      background: linear-gradient(135deg, #FFF9EF, #F3F9EE);
      border: 1.5px dashed rgba(135,185,116,0.45);
      border-radius: var(--radius-md); padding: 0.5rem 0.65rem;
      font-size: 0.78rem; color: var(--ink-soft); margin-bottom: 0.65rem;
    }
    .tip-box strong { color: var(--avocado-deep); }
    .search-row {
      font-size: 0.76rem; color: var(--ink-soft); margin-bottom: 0.65rem;
      display: flex; flex-wrap: wrap; gap: 0.25rem 0.45rem; align-items: center;
    }
    .search-row code {
      background: var(--cream-deep); border-radius: 6px; padding: 0.1rem 0.38rem;
      font-family: ui-monospace, Consolas, monospace; font-size: 0.74rem; color: var(--caramel);
    }
    .card-actions {
      display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.45rem; margin-top: auto; padding-top: 0.35rem;
    }
    .card-actions .btn, .card-actions a.btn { width: 100%; min-width: 0; }
    .card-actions .btn-full { grid-column: 1 / -1; }
    .card-actions .btn-swap { grid-column: 1 / -1; }

    .bottom-actions {
      display: flex; flex-wrap: wrap; gap: 0.45rem;
      margin-top: 0.95rem; padding-top: 0.85rem; border-top: 1.5px dashed var(--line);
    }
    .bottom-actions .btn { flex: 1 1 auto; min-width: 7.2rem; }

    .no-match {
      background: #FFF4F1; border: 1.5px solid rgba(255,107,87,0.35);
      border-radius: var(--radius-md); padding: clamp(1rem, 3vw, 1.4rem);
      text-align: center; width: 100%; min-width: 0; grid-column: 1 / -1;
    }
    .no-match h3 { margin: 0 0 0.35rem; color: var(--tomato-deep); font-size: 0.96rem; }
    .no-match p { margin: 0 0 0.75rem; font-size: 0.84rem; color: var(--ink-soft); }

    /* 历史抽屉 */
    .drawer-mask {
      position: fixed; inset: 0; background: rgba(61,43,34,0.35);
      z-index: 40; opacity: 0; pointer-events: none; transition: opacity 0.25s ease;
    }
    .drawer-mask.is-open { opacity: 1; pointer-events: auto; }
    .history-drawer {
      position: fixed; z-index: 45; background: var(--cream);
      box-shadow: var(--shadow); display: flex; flex-direction: column;
      transition: transform 0.3s cubic-bezier(0.34, 1.1, 0.64, 1);
    }
    @media (min-width: 768px) {
      .history-drawer {
        top: 0; right: 0; bottom: 0; width: min(400px, 92vw);
        transform: translateX(105%); border-left: 1.5px solid var(--line);
      }
      .history-drawer.is-open { transform: translateX(0); }
    }
    @media (max-width: 767px) {
      .history-drawer {
        left: 0; right: 0; bottom: 0;
        height: min(88dvh, 100%); max-height: 100dvh;
        border-radius: 20px 20px 0 0; transform: translateY(105%);
        padding-bottom: var(--safe-b);
      }
      .history-drawer.is-open { transform: translateY(0); }
      .history-drawer .drawer-handle {
        width: 40px; height: 4px; border-radius: 4px; background: var(--line);
        margin: 0.55rem auto 0.2rem;
      }
    }
    .drawer-head {
      display: flex; align-items: center; justify-content: space-between;
      gap: 0.5rem; padding: 0.9rem 1rem 0.55rem; border-bottom: 1.5px solid var(--line);
    }
    .drawer-head h2 { margin: 0; font-size: 1rem; color: var(--caramel); }
    .drawer-tabs {
      display: flex; gap: 0.35rem; padding: 0.65rem 1rem 0;
    }
    .drawer-tabs .chip { font-size: 0.76rem; }
    .drawer-body {
      flex: 1; overflow: auto; padding: 0.7rem 1rem 1rem;
      -webkit-overflow-scrolling: touch;
    }
    .hist-item {
      background: #fff; border: 1.5px solid var(--line); border-radius: var(--radius-md);
      padding: 0.65rem 0.7rem; margin-bottom: 0.5rem;
    }
    .hist-item .hist-top {
      display: flex; justify-content: space-between; gap: 0.4rem; align-items: flex-start;
      margin-bottom: 0.3rem;
    }
    .hist-item .hist-time { font-size: 0.78rem; font-weight: 700; color: var(--caramel); }
    .hist-item .hist-action {
      font-size: 0.7rem; font-weight: 600; color: var(--tomato-deep);
      background: #FDECEA; border-radius: var(--radius-pill); padding: 0.1rem 0.45rem;
      white-space: nowrap;
    }
    .hist-item .hist-names { font-size: 0.8rem; color: var(--ink-soft); line-height: 1.4; }
    .hist-item .hist-actions {
      display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.5rem;
    }
    .drawer-foot {
      padding: 0.65rem 1rem calc(0.85rem + var(--safe-b));
      border-top: 1.5px solid var(--line); background: rgba(255,248,238,0.95);
    }

    .toast-host {
      position: fixed; left: 50%; bottom: calc(1.2rem + var(--safe-b) + var(--sticky-h));
      transform: translateX(-50%); z-index: 60; width: min(92vw, 360px); pointer-events: none;
    }
    .toast {
      background: var(--caramel); color: #fff; padding: 0.7rem 1rem;
      border-radius: var(--radius-md); box-shadow: var(--shadow);
      font-size: 0.86rem; text-align: center; opacity: 0;
      transform: translateY(12px); transition: opacity 0.25s ease, transform 0.25s ease;
    }
    .toast.is-on { opacity: 1; transform: translateY(0); }

    .site-footer {
      margin-top: 1.4rem; text-align: center; font-size: 0.74rem;
      color: var(--caramel-soft); line-height: 1.6; padding: 0 0.5rem;
    }
    .site-footer a { color: var(--caramel); }

    @keyframes cardSwap {
      0% { transform: scale(1); }
      40% { transform: scale(0.96) rotateY(8deg); opacity: 0.65; }
      100% { transform: scale(1) rotateY(0); opacity: 1; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
      .meal-card { opacity: 1; transform: none; }
      .btn:hover, .chip:hover { transform: none; }
      .history-drawer, .drawer-mask { transition: none; }
    }
    /* Tablet */
    @media (max-width: 1023px) {
      .filter-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .filter-block--span2 { grid-column: 1 / -1; }
      .meal-list { grid-template-columns: 1fr; }
      .filter-actions .btn-primary { flex: 1 1 100%; width: 100%; min-width: 0; }
      .meta-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }

    /* Phone */
    @media (max-width: 767px) {
      :root { --sticky-h: 72px; }
      .header-meta {
        padding: 0.2rem 0; background: none; border: none; box-shadow: none;
      }
      .header-meta .date { font-size: 0.72rem; }
      .header-meta .greet { display: none; }
      .brand-text p { display: none; }
      .filter-grid { grid-template-columns: 1fr; gap: 12px; }
      .filter-block--span2 { grid-column: auto; }
      .filter-mobile-collapse { display: none; }
      .panel-controls:not(.is-collapsed) .more-panel { display: block; }
      .filter-actions { display: none; }
      .sticky-cta { display: block; }
      .meta-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .bottom-actions .btn { min-width: calc(50% - 0.3rem); }
    }

    @media (min-width: 768px) {
      .more-panel { display: none !important; }
      .sticky-cta { display: none !important; }
      .filter-mobile-collapse { display: block; }
    }

    details.more-panel {
      border: 1.5px solid var(--line); border-radius: var(--radius-md);
      background: #fff; margin-top: 12px; overflow: hidden; min-width: 0;
    }
    details.more-panel > summary {
      cursor: pointer; list-style: none; padding: 0.7rem 0.85rem;
      min-height: var(--touch); font-size: 0.84rem; font-weight: 700; color: var(--caramel);
      display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
    }
    details.more-panel > summary::-webkit-details-marker { display: none; }
    details.more-panel > summary::after { content: "▾"; color: var(--caramel-soft); }
    details.more-panel[open] > summary::after { transform: rotate(180deg); }
    details.more-panel .more-body { padding: 0 0.85rem 0.9rem; display: grid; gap: 0.85rem; min-width: 0; }

    /* ----- 今日能量 ----- */
    .energy-card {
      background: rgba(255,255,255,0.88);
      border: 1.5px solid var(--line);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-soft);
      padding: clamp(12px, 1.8vw, 16px) clamp(14px, 2vw, 20px);
      min-width: 0;
    }
    .energy-card-inner {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 12px 18px;
      align-items: center;
      min-width: 0;
    }
    .energy-ring-wrap {
      width: 72px; height: 72px; position: relative; flex-shrink: 0;
    }
    .energy-ring-wrap svg { width: 100%; height: 100%; transform: rotate(-90deg); }
    .energy-ring-wrap .er-bg { fill: none; stroke: var(--cream-deep); stroke-width: 8; }
    .energy-ring-wrap .er-fg {
      fill: none; stroke: var(--avocado); stroke-width: 8;
      stroke-linecap: round; transition: stroke-dashoffset 0.4s ease;
    }
    .energy-ring-wrap.over .er-fg { stroke: #E8B040; }
    .energy-ring-center {
      position: absolute; inset: 0; display: grid; place-items: center;
      font-size: 0.68rem; font-weight: 700; color: var(--caramel); text-align: center;
      line-height: 1.15; padding: 4px;
    }
    .energy-main { min-width: 0; }
    .energy-title {
      margin: 0 0 0.2rem; font-size: 0.9rem; font-weight: 700; color: var(--caramel);
    }
    .energy-nums {
      font-size: clamp(1.05rem, 2.2vw, 1.25rem); font-weight: 800; color: var(--ink);
      letter-spacing: -0.02em;
    }
    .energy-nums span { color: var(--caramel-soft); font-weight: 600; font-size: 0.9em; }
    .energy-hint { margin: 0.25rem 0 0; font-size: 0.75rem; color: var(--ink-soft); }
    .energy-meals {
      display: flex; flex-wrap: wrap; gap: 0.35rem 0.55rem;
      margin-top: 0.45rem; font-size: 0.74rem; color: var(--ink-soft);
    }
    .energy-meals b { color: var(--caramel); font-weight: 700; }
    .energy-actions {
      display: flex; flex-direction: column; gap: 0.4rem; align-items: stretch;
      min-width: 0;
    }
    .energy-actions .btn { white-space: nowrap; }
    .energy-compact { display: none; }
    .energy-full { display: block; min-width: 0; }

    @media (max-width: 767px) {
      .energy-card-inner { grid-template-columns: 1fr; gap: 0; }
      .energy-full { display: none; }
      .energy-compact {
        display: flex; align-items: center; justify-content: space-between;
        gap: 0.6rem; min-width: 0; width: 100%;
      }
      .energy-compact-text {
        font-size: 0.9rem; font-weight: 700; color: var(--caramel);
        min-width: 0; overflow-wrap: anywhere;
      }
      .energy-actions { flex-direction: row; flex-wrap: wrap; }
    }
    @media (min-width: 768px) {
      .energy-compact { display: none !important; }
    }

    /* ----- 打卡 / 补记 弹层 ----- */
    .modal-mask {
      position: fixed; inset: 0; z-index: 70;
      background: rgba(61,43,34,0.4);
      opacity: 0; pointer-events: none;
      transition: opacity 0.25s ease;
    }
    .modal-mask.is-open { opacity: 1; pointer-events: auto; }
    .modal-sheet {
      position: fixed; z-index: 75;
      background: var(--cream);
      box-shadow: var(--shadow);
      display: flex; flex-direction: column;
      min-width: 0; max-width: 100%;
      transform: translateY(110%);
      transition: transform 0.3s cubic-bezier(0.34, 1.1, 0.64, 1);
    }
    @media (min-width: 768px) {
      .modal-sheet {
        left: 50%; top: 50%; bottom: auto;
        width: min(440px, 92vw);
        max-height: min(86vh, 720px);
        border-radius: var(--radius-lg);
        transform: translate(-50%, -46%) scale(0.96);
        opacity: 0;
        pointer-events: none;
        transition: transform 0.25s ease, opacity 0.25s ease;
      }
      .modal-sheet.is-open {
        transform: translate(-50%, -50%) scale(1);
        opacity: 1; pointer-events: auto;
      }
    }
    @media (max-width: 767px) {
      .modal-sheet {
        left: 0; right: 0; bottom: 0;
        height: min(92dvh, 100%);
        max-height: 100dvh;
        border-radius: 20px 20px 0 0;
        padding-bottom: var(--safe-b);
      }
      .modal-sheet.is-open { transform: translateY(0); }
      .modal-sheet .modal-handle {
        width: 40px; height: 4px; border-radius: 4px; background: var(--line);
        margin: 0.55rem auto 0.15rem;
      }
    }
    .modal-head {
      display: flex; align-items: center; justify-content: space-between;
      gap: 0.5rem; padding: 0.75rem 1rem 0.5rem;
      border-bottom: 1.5px solid var(--line);
    }
    .modal-head h3 { margin: 0; font-size: 1rem; color: var(--caramel); }
    .modal-body {
      flex: 1; overflow: auto; padding: 0.85rem 1rem 1rem;
      -webkit-overflow-scrolling: touch; min-height: 0;
    }
    .modal-foot {
      display: flex; flex-wrap: wrap; gap: 0.45rem;
      padding: 0.65rem 1rem calc(0.75rem + var(--safe-b));
      border-top: 1.5px solid var(--line);
      background: rgba(255,248,238,0.96);
    }
    .modal-foot .btn { flex: 1 1 auto; min-width: 5.5rem; }

    .form-field { margin-bottom: 0.75rem; min-width: 0; }
    .form-field label {
      display: block; font-size: 0.76rem; font-weight: 700;
      color: var(--caramel-soft); margin-bottom: 0.35rem;
    }
    .form-field input[type="text"],
    .form-field input[type="number"],
    .form-field input[type="time"],
    .form-field select,
    .form-field textarea {
      width: 100%; max-width: 100%;
      min-height: var(--touch);
      font-size: 16px; /* iOS 防缩放 */
      padding: 0.55rem 0.7rem;
      border: 1.5px solid var(--line);
      border-radius: var(--radius-sm);
      background: #fff; color: var(--ink);
    }
    .form-field textarea { min-height: 72px; resize: vertical; }
    .form-hint { margin: 0.3rem 0 0; font-size: 0.74rem; color: var(--ink-soft); }
    .portion-row { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .portion-row .chip { flex: 1 1 auto; text-align: center; justify-content: center; }

    .quick-foods {
      display: flex; flex-wrap: wrap; gap: 0.35rem;
      max-height: 140px; overflow: auto; margin-bottom: 0.5rem;
    }
    .quick-foods .chip { font-size: 0.76rem; }

    .log-list { display: grid; gap: 0.45rem; margin-top: 0.5rem; }
    .log-item {
      background: #fff; border: 1.5px solid var(--line);
      border-radius: var(--radius-sm); padding: 0.55rem 0.65rem;
      display: flex; justify-content: space-between; gap: 0.5rem; align-items: flex-start;
      min-width: 0;
    }
    .log-item .log-body { min-width: 0; flex: 1; font-size: 0.82rem; color: var(--ink-soft); }
    .log-item strong { display: block; color: var(--caramel); font-size: 0.86rem; overflow-wrap: anywhere; }
    .log-item .log-kcal { font-weight: 700; color: var(--caramel); white-space: nowrap; }
    .log-item .log-ops { display: flex; flex-wrap: wrap; gap: 0.25rem; }

    .btn-checked {
      background: linear-gradient(180deg, #9BCB84, var(--avocado));
      color: #fff; border: none; box-shadow: 0 2px 0 var(--avocado-deep);
      font-size: 0.8rem; font-weight: 700;
    }
    .btn-quiet {
      background: transparent; color: var(--caramel-soft);
      border: 1.5px dashed var(--line); font-size: 0.78rem; font-weight: 600;
    }
    .energy-settings-row {
      display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;
      margin-top: 0.65rem; padding-top: 0.55rem; border-top: 1px dashed var(--line);
    }
    .energy-settings-row label { font-size: 0.8rem; color: var(--ink-soft); display: flex; align-items: center; gap: 0.35rem; }
    .energy-settings-row input[type="number"] {
      width: 5.5rem; min-height: 40px; font-size: 16px;
      border: 1.5px solid var(--line); border-radius: 8px; padding: 0.3rem 0.45rem;
    }
    body.modal-open { overflow: hidden; }
    body.modal-open .sticky-cta { visibility: hidden; pointer-events: none; }

  </style>
</head>
<body>
  <div class="bg-deco" aria-hidden="true">
    <div class="blob blob-a"></div>
    <div class="blob blob-b"></div>
    <div class="blob blob-c"></div>
  </div>

  <div class="page">
    <header class="site-header">
      <div class="brand">
        <div class="brand-mark" aria-hidden="true">🍱</div>
        <div class="brand-text">
          <h1>饭饭搭子</h1>
          <p>替选择困难的你，认真想好今天三顿饭</p>
        </div>
      </div>
      <div class="header-right">
        <div class="header-meta">
          <div class="date" id="todayDate">—</div>
          <div class="greet" id="greeting">你好呀</div>
        </div>
        <button type="button" class="btn btn-ghost btn-icon" id="btnOpenHistory" aria-haspopup="dialog" aria-label="历史记录" title="历史记录">📋</button>
      </div>
    </header>

    <main class="layout">
      <!-- 顶部筛选 -->
      <section class="panel panel-controls" id="filterPanel" aria-label="筛选与安排">
        <div class="filter-summary" id="filterSummary">
          <div class="filter-summary-text" id="filterSummaryText">—</div>
          <button type="button" class="btn btn-secondary btn-sm" id="btnEditFilters">修改</button>
        </div>

        <div class="filter-full" id="filterFull">
          <h2 class="panel-title"><span class="dot" aria-hidden="true"></span>今天怎么吃</h2>

          <div class="filter-grid" id="primaryFilters">
            <div class="filter-block">
              <span class="filter-label" id="labelScene">场景</span>
              <div class="chip-row" role="radiogroup" aria-labelledby="labelScene" id="sceneGroup">
                <button type="button" class="chip" data-scene="office" role="radio" aria-checked="true">在公司</button>
                <button type="button" class="chip" data-scene="home" role="radio" aria-checked="false">在家</button>
                <button type="button" class="chip" data-scene="overtime" role="radio" aria-checked="false">今天加班</button>
                <button type="button" class="chip" data-scene="post_workout" role="radio" aria-checked="false">刚运动完</button>
              </div>
            </div>
            <div class="filter-block">
              <span class="filter-label" id="labelGoal">饮食目标</span>
              <div class="chip-row" role="radiogroup" aria-labelledby="labelGoal" id="goalGroup">
                <button type="button" class="chip" data-goal="casual" role="radio" aria-checked="true">随心吃</button>
                <button type="button" class="chip" data-goal="light" role="radio" aria-checked="false">吃轻一点</button>
                <button type="button" class="chip" data-goal="high_protein" role="radio" aria-checked="false">高蛋白</button>
                <button type="button" class="chip" data-goal="ovo_lacto" role="radio" aria-checked="false">蛋奶素</button>
              </div>
            </div>
            <div class="filter-block">
              <span class="filter-label" id="labelChannel">用餐方式</span>
              <div class="chip-row" role="radiogroup" aria-labelledby="labelChannel" id="channelGroup">
                <button type="button" class="chip" data-channel="any" role="radio" aria-checked="true">都可以</button>
                <button type="button" class="chip" data-channel="canteen" role="radio" aria-checked="false">食堂</button>
                <button type="button" class="chip" data-channel="takeout" role="radio" aria-checked="false">外卖</button>
                <button type="button" class="chip" data-channel="convenience" role="radio" aria-checked="false">便利店</button>
                <button type="button" class="chip" data-channel="home_cook" role="radio" aria-checked="false">自己做</button>
              </div>
            </div>
          </div>

          <details class="more-panel" id="morePanel">
            <summary id="morePanelSummary">⚙️ 更多条件</summary>
            <div class="more-body" id="moreBody"></div>
          </details>

          <div class="filter-grid" id="secondaryFilters">
            <div class="filter-block">
              <span class="filter-label" id="labelHunger">胃口</span>
              <div class="chip-row" role="radiogroup" aria-labelledby="labelHunger" id="hungerGroup">
                <button type="button" class="chip" data-hunger="low" role="radio" aria-checked="false">没什么胃口</button>
                <button type="button" class="chip" data-hunger="normal" role="radio" aria-checked="true">正常</button>
                <button type="button" class="chip" data-hunger="starving" role="radio" aria-checked="false">非常饿</button>
              </div>
            </div>
            <div class="filter-block filter-block--span2">
              <span class="filter-label" id="labelTaste">口味（可多选）</span>
              <div class="chip-row" role="group" aria-labelledby="labelTaste" id="tasteGroup">
                <button type="button" class="chip" data-taste="hot" aria-pressed="false">热乎乎</button>
                <button type="button" class="chip" data-taste="refreshing" aria-pressed="false">清爽</button>
                <button type="button" class="chip" data-taste="spicy" aria-pressed="false">香辣</button>
                <button type="button" class="chip" data-taste="sweet_sour" aria-pressed="false">酸甜</button>
                <button type="button" class="chip" data-taste="soupy" aria-pressed="false">汤汤水水</button>
                <button type="button" class="chip" data-taste="rice_friendly" aria-pressed="false">特别下饭</button>
              </div>
            </div>
            <div class="filter-block">
              <span class="filter-label" id="labelBudget">预算</span>
              <div class="chip-row" role="radiogroup" aria-labelledby="labelBudget" id="budgetGroup">
                <button type="button" class="chip" data-budget="any" role="radio" aria-checked="true">不限制</button>
                <button type="button" class="chip" data-budget="under15" role="radio" aria-checked="false">15元以内</button>
                <button type="button" class="chip" data-budget="15to30" role="radio" aria-checked="false">15～30元</button>
                <button type="button" class="chip" data-budget="over30" role="radio" aria-checked="false">30元以上</button>
              </div>
            </div>
            <div class="filter-block filter-block--span2" id="conditionalExtras" hidden>
              <div class="cond-block" id="homeCookExtras" hidden>
                <div class="filter-block" style="margin-bottom:0.55rem">
                  <span class="filter-label" id="labelEquip">厨具</span>
                  <div class="chip-row" role="radiogroup" aria-labelledby="labelEquip" id="equipGroup">
                    <button type="button" class="chip" data-equip="any" role="radio" aria-checked="true">不限</button>
                    <button type="button" class="chip" data-equip="wok" role="radio" aria-checked="false">炒锅</button>
                    <button type="button" class="chip" data-equip="microwave" role="radio" aria-checked="false">微波炉</button>
                    <button type="button" class="chip" data-equip="rice_cooker" role="radio" aria-checked="false">电饭煲</button>
                    <button type="button" class="chip" data-equip="none" role="radio" aria-checked="false">几乎不用开火</button>
                  </div>
                </div>
                <div class="filter-block" style="margin-bottom:0">
                  <span class="filter-label" id="labelPrep">做饭时间</span>
                  <div class="chip-row" role="radiogroup" aria-labelledby="labelPrep" id="prepGroup">
                    <button type="button" class="chip" data-prep="any" role="radio" aria-checked="true">不着急</button>
                    <button type="button" class="chip" data-prep="10" role="radio" aria-checked="false">10 分钟</button>
                    <button type="button" class="chip" data-prep="20" role="radio" aria-checked="false">20 分钟</button>
                    <button type="button" class="chip" data-prep="30" role="radio" aria-checked="false">30 分钟</button>
                  </div>
                </div>
              </div>
              <div class="cond-block" id="takeoutExtras" hidden>
                <div class="filter-block" style="margin-bottom:0">
                  <span class="filter-label" id="labelWait">可接受等待</span>
                  <div class="chip-row" role="radiogroup" aria-labelledby="labelWait" id="waitGroup">
                    <button type="button" class="chip" data-wait="any" role="radio" aria-checked="true">不限</button>
                    <button type="button" class="chip" data-wait="20" role="radio" aria-checked="false">20 分钟内</button>
                    <button type="button" class="chip" data-wait="30" role="radio" aria-checked="false">30 分钟内</button>
                    <button type="button" class="chip" data-wait="45" role="radio" aria-checked="false">45 分钟内</button>
                  </div>
                </div>
              </div>
            </div>
            <div class="filter-block filter-block--span2">
              <details class="advanced" id="advancedBox">
                <summary>再挑剔一点 · 忌口</summary>
                <div class="adv-body">
                  <div class="chip-row" role="group" aria-label="忌口" id="tagGroup">
                    <button type="button" class="chip tag-chip" data-tag="noSpicy" aria-pressed="false">不辣</button>
                    <button type="button" class="chip tag-chip" data-tag="noBeef" aria-pressed="false">不吃牛肉</button>
                    <button type="button" class="chip tag-chip" data-tag="noPork" aria-pressed="false">不吃猪肉</button>
                    <button type="button" class="chip tag-chip" data-tag="noSeafood" aria-pressed="false">不吃海鲜</button>
                    <button type="button" class="chip tag-chip" data-tag="noEgg" aria-pressed="false">不吃鸡蛋</button>
                    <button type="button" class="chip tag-chip" data-tag="noMilk" aria-pressed="false">不喝牛奶</button>
                    <button type="button" class="chip tag-chip" data-tag="noNuts" aria-pressed="false">不吃花生坚果</button>
                  </div>
                </div>
              </details>
            </div>
          </div>

          <div class="filter-actions">
            <p class="hint" id="modeHint">今天已经做了很多决定，吃什么就交给我吧。</p>
            <button type="button" class="btn btn-primary" id="btnArrange">帮我安排今天三顿饭</button>
          </div>
          <div class="side-tools">
            <button type="button" class="btn btn-ghost btn-sm" id="btnToggleFav" aria-expanded="false">我的收藏</button>
          </div>
          <div id="favPanel" hidden style="margin-top:0.7rem">
            <ul id="favList" style="list-style:none;margin:0;padding:0;display:grid;gap:0.4rem;max-height:180px;overflow:auto"></ul>
            <p class="hint" id="favEmpty" hidden>还没有收藏。</p>
          </div>
        </div>
      </section>


      <!-- 今日能量 -->
      <section class="energy-card" id="energyCard" aria-label="今日能量">
        <div class="energy-compact" id="energyCompact">
          <div class="energy-compact-text" id="energyCompactText">今日 0 kcal · 未设目标</div>
          <button type="button" class="btn btn-secondary btn-sm" id="btnEnergyDetail">查看</button>
        </div>
        <div class="energy-full" id="energyFull">
          <div class="energy-card-inner">
            <div class="energy-ring-wrap" id="energyRingWrap" hidden>
              <svg viewBox="0 0 72 72" aria-hidden="true">
                <circle class="er-bg" cx="36" cy="36" r="28"></circle>
                <circle class="er-fg" id="energyRingFg" cx="36" cy="36" r="28"
                  stroke-dasharray="175.93" stroke-dashoffset="175.93"></circle>
              </svg>
              <div class="energy-ring-center" id="energyRingLabel">—</div>
            </div>
            <div class="energy-main">
              <p class="energy-title">今日能量 · 吃饭打卡</p>
              <div class="energy-nums" id="energyNums">0 <span>kcal</span></div>
              <p class="energy-hint" id="energyHint">记下来就很好，不需要每顿都完美。</p>
              <div class="energy-meals" id="energyMealSplit"></div>
              <div class="energy-settings-row">
                <label>
                  <input type="checkbox" id="chkCalTarget" />
                  设置每日热量目标
                </label>
                <label id="targetInputWrap" hidden>
                  目标
                  <input type="number" id="inputCalTarget" min="800" max="5000" step="50" value="1800" inputmode="numeric" />
                  kcal
                </label>
              </div>
            </div>
            <div class="energy-actions">
              <button type="button" class="btn btn-secondary btn-sm" id="btnAddFood">+ 补记食物</button>
              <button type="button" class="btn btn-ghost btn-sm" id="btnEnergyLogs">今日明细</button>
            </div>
          </div>
        </div>
      </section>

      <!-- 下方结果 -->
      <section class="panel panel-results" id="resultsPanel" aria-label="今日三餐" aria-live="polite">
        <div class="results-head">
          <div>
            <h2>今日菜单</h2>
            <p class="results-sub" id="resultsSub">选好条件后点主按钮，三顿饭会在这里揭晓</p>
          </div>
        </div>
        <div id="softenNotice" class="soften-banner" hidden></div>
        <div id="resultsArea"></div>
        <div class="bottom-actions" id="bottomActions" hidden>
          <button type="button" class="btn btn-secondary" id="btnRerollAll">全部换一组</button>
          <button type="button" class="btn btn-quiet btn-sm" id="btnRerollAllForce" hidden>仍然重新安排全部</button>
          <button type="button" class="btn btn-secondary" id="btnAddFoodBottom">+ 补记食物</button>
          <button type="button" class="btn btn-secondary" id="btnFavorite">收藏今天</button>
          <button type="button" class="btn btn-secondary" id="btnCopy">复制今日菜单</button>
        </div>
        <p class="hint" id="rerollLockHint" hidden style="margin-top:0.5rem"></p>
      </section>
    </main>

    <div class="sticky-cta" id="stickyCta">
      <button type="button" class="btn btn-primary" id="btnArrangeSticky">帮我安排今天三顿饭</button>
    </div>

    <footer class="site-footer">
      <p>热量为估算范围，仅供参考，不构成营养或医疗建议。</p>
      <p>
        自制菜谱优先链接
        <a href="https://github.com/Anduin2017/HowToCook" target="_blank" rel="noopener noreferrer">HowToCook</a>
        · 数据仅存本机
      </p>
    </footer>
  </div>

  <!-- 历史抽屉 -->
  <div class="drawer-mask" id="drawerMask" hidden></div>
  <aside class="history-drawer" id="historyDrawer" role="dialog" aria-modal="true" aria-labelledby="histTitle" hidden>
    <div class="drawer-handle" aria-hidden="true"></div>
    <div class="drawer-head">
      <h2 id="histTitle">历史记录</h2>
      <button type="button" class="btn btn-ghost btn-sm" id="btnCloseHistory" aria-label="关闭">关闭</button>
    </div>
    <div class="drawer-tabs" role="tablist">
      <button type="button" class="chip" id="tabRecommend" role="tab" aria-selected="true" aria-pressed="true">推荐历史</button>
      <button type="button" class="chip" id="tabEaten" role="tab" aria-selected="false" aria-pressed="false">真正吃过</button>
    </div>
    <div class="drawer-body" id="drawerBody"></div>
    <div class="drawer-foot" id="drawerFoot">
      <button type="button" class="btn btn-danger btn-sm" id="btnClearHistory" style="width:100%">清空全部推荐历史</button>
    </div>
  </aside>


  <!-- 吃了这顿 / 补记 / 能量明细 -->
  <div class="modal-mask" id="modalMask" hidden></div>

  <div class="modal-sheet" id="checkinModal" role="dialog" aria-modal="true" aria-labelledby="checkinTitle" hidden>
    <div class="modal-handle" aria-hidden="true"></div>
    <div class="modal-head">
      <h3 id="checkinTitle">吃了这顿</h3>
      <button type="button" class="btn btn-ghost btn-sm" id="btnCloseCheckin" aria-label="关闭">关闭</button>
    </div>
    <div class="modal-body">
      <p class="form-hint" id="checkinLead">这顿大约是多少？可以按实际情况改一改。</p>
      <div class="form-field">
        <label for="checkinName">菜名</label>
        <input type="text" id="checkinName" maxlength="60" autocomplete="off" />
      </div>
      <div class="form-field">
        <label>分量</label>
        <div class="portion-row" role="radiogroup" aria-label="分量" id="portionGroup">
          <button type="button" class="chip" data-portion="0.7" aria-checked="false" role="radio">少量 · 0.7份</button>
          <button type="button" class="chip" data-portion="1" aria-checked="true" role="radio">标准 · 1份</button>
          <button type="button" class="chip" data-portion="1.3" aria-checked="false" role="radio">大份 · 1.3份</button>
        </div>
      </div>
      <div class="form-field">
        <label for="checkinKcal">热量估算（kcal）</label>
        <input type="number" id="checkinKcal" min="1" max="5000" step="1" inputmode="numeric" />
        <p class="form-hint">热量是估算值，分量和做法都会影响结果。</p>
      </div>
      <input type="hidden" id="checkinMeal" />
      <input type="hidden" id="checkinDishId" />
      <input type="hidden" id="checkinLogId" />
      <input type="hidden" id="checkinBaseKcal" />
    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-danger btn-sm" id="btnDeleteCheckin" hidden>删除记录</button>
      <button type="button" class="btn btn-secondary" id="btnCancelCheckin">取消</button>
      <button type="button" class="btn btn-primary" id="btnSaveCheckin">保存</button>
    </div>
  </div>

  <div class="modal-sheet" id="addFoodModal" role="dialog" aria-modal="true" aria-labelledby="addFoodTitle" hidden>
    <div class="modal-handle" aria-hidden="true"></div>
    <div class="modal-head">
      <h3 id="addFoodTitle">补记食物</h3>
      <button type="button" class="btn btn-ghost btn-sm" id="btnCloseAddFood" aria-label="关闭">关闭</button>
    </div>
    <div class="modal-body">
      <p class="form-hint">记下来就很好，不需要每顿都完美。以下为估算值。</p>
      <div class="form-field">
        <label>常见食物（点选填入）</label>
        <div class="quick-foods" id="quickFoods"></div>
      </div>
      <div class="form-field">
        <label>最近记录</label>
        <div class="quick-foods" id="recentFoods"></div>
      </div>
      <div class="form-field">
        <label for="addFoodName">食物名称</label>
        <input type="text" id="addFoodName" maxlength="60" autocomplete="off" />
      </div>
      <div class="form-field">
        <label for="addFoodPortion">分量说明</label>
        <input type="text" id="addFoodPortion" maxlength="40" placeholder="如：中杯 / 1碗 / 半份" autocomplete="off" />
      </div>
      <div class="form-field">
        <label for="addFoodKcal">大卡（kcal）</label>
        <input type="number" id="addFoodKcal" min="1" max="5000" step="1" inputmode="numeric" />
      </div>
      <div class="form-field">
        <label for="addFoodMeal">餐次</label>
        <select id="addFoodMeal">
          <option value="breakfast">早餐</option>
          <option value="lunch">午餐</option>
          <option value="dinner">晚餐</option>
          <option value="snack">加餐</option>
          <option value="drink">饮料</option>
        </select>
      </div>
      <div class="form-field">
        <label for="addFoodTime">时间</label>
        <input type="time" id="addFoodTime" />
      </div>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-secondary" id="btnCancelAddFood">取消</button>
      <button type="button" class="btn btn-primary" id="btnSaveAddFood">保存</button>
    </div>
  </div>

  <div class="modal-sheet" id="energyDetailModal" role="dialog" aria-modal="true" aria-labelledby="energyDetailTitle" hidden>
    <div class="modal-handle" aria-hidden="true"></div>
    <div class="modal-head">
      <h3 id="energyDetailTitle">今日摄入明细</h3>
      <button type="button" class="btn btn-ghost btn-sm" id="btnCloseEnergyDetail" aria-label="关闭">关闭</button>
    </div>
    <div class="modal-body">
      <div class="energy-nums" id="energyDetailTotal" style="margin-bottom:0.5rem">0 kcal</div>
      <p class="form-hint" id="energyDetailHint">热量是估算值，仅供参考。</p>
      <div class="log-list" id="energyLogList"></div>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn btn-secondary" id="btnCloseEnergyDetail2">好的</button>
      <button type="button" class="btn btn-primary" id="btnAddFoodFromDetail">+ 补记食物</button>
    </div>
  </div>


  <div class="toast-host" aria-live="assertive" aria-atomic="true">
    <div class="toast" id="toast" role="status"></div>
  </div>

  <script>
  /* =========================================================
     饭饭搭子 · app
     1. 常量与存储
     2. 菜品数据 DISHES（可拆 JSON）
     3. 工具 / 种子随机
     4. 设置与历史读写
     5. 筛选与推荐引擎
     6. 生成 / 恢复（独立函数）
     7. UI 渲染
     8. 事件与初始化
     ========================================================= */
  (function () {
    "use strict";

    /* ---------- 1. 常量 ---------- */
    var STORAGE = {
      settings: "fanfan_settings_v2",
      currentMenu: "fanfan_current_menu_v2",
